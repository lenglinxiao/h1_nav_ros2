    {
      "id": "RecordTeachingPath",
      "type": "class",
      "name": "RecordTeachingPath",
      "filePath": "src/h1_2_nav_tools/h1_2_nav_tools/record_teaching_path.py",
      "summary": "ROS2 节点类，实现示教路径录制功能。提供 ROS2 服务接口（start/stop_and_save）和交互式控制台两种操作方式。录制时按距离阈值（默认0.1m）采样位姿点，通过 TF 转换到目标坐标系，支持多条路径录制并保存为文本文件。具备 TF 可用性预检功能，确保离线重定位就绪后才允许录制。",
      "tags": ["ROS2节点", "ROS2服务", "路径录制", "示教", "交互式控制台", "TF预检", "多线程"],
      "complexity": "medium",
      "languageNotes": "采用 threading.Lock 保护路径数据的并发访问；支持交互式控制台和 ROS2 spin 双线程并行运行"
    },
