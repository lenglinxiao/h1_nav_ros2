# Copy to ~/.config/h1-policy-owner.env and replace paths for the target machine.
# systemd stop waits until policy runtime status proves output is unauthorized and writer-free.
# All commands are tokenized with shlex; they are never run through a shell.
# The example disables output. The owner never invokes the bridge authorization service.
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
H1_ROS_SETUP=/opt/ros/humble/setup.bash
H1_WORKSPACE_SETUP=/home/unitree/h1_nav2_ros2_ws/install/setup.bash
H1_POLICY_OWNER_BRIDGE_COMMAND="/home/unitree/h1_nav2_ros2_ws/install/h1_2_policy_bridge/lib/h1_2_policy_bridge/h1_2_policy_node --ros-args -p profile:=hardware -p network_interface:=eth0 -p dds_domain:=0 -p model_path:=/home/unitree/h1_nav2_ros2_ws/models/h1_2_armhold/policy.onnx -p enable_hardware_output:=false -p continuous_policy_navigation:=false -p enable_navigation_commands:=false -p input_identity_mode:=claimed -p owner_boot_id:={owner_boot_id} -p owner_pid:={owner_pid}"
H1_POLICY_OWNER_COORDINATOR_COMMAND="ros2 run h1_2_nav_tools policy_motion_coordinator --ros-args -p owner_boot_id:={owner_boot_id}"
# Leave unset to use ~/.local/state/h1-policy-owner, or provide an absolute writable path.
# Replace this explicit placeholder with the reviewed persistent monitor binary and its arguments.
# This example is intentionally non-runnable until the deployment path is supplied.
H1_POLICY_OWNER_MONITOR_COMMAND="/absolute/path/to/reviewed-persistent-monitor {run_dir}/telemetry.json {run_dir}/trace.csv {run_dir}/writer-guid.json"
