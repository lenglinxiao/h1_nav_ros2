<?xml version="1.0"?>
<package format="3">
  <name>h1_2_bag_benchmark</name>
  <version>0.1.0</version>
  <description>Rosbag regression tools for H1-2 FAST-LIO mapping and localization.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>fast_lio2</exec_depend>
  <exec_depend>h1_2_icp_localization</exec_depend>
  <exec_depend>h1_2_slam_bringup</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
