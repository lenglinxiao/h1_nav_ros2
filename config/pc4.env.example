# Copy to ~/.config/h1-2/pc4.env on PC4 and adjust paths as needed.
H1_2_RUNTIME_PROFILE=pc4
H1_2_WORKSPACE=/home/unitree/h1_nav2_ros2_ws
H1_2_NAV_WS=/home/unitree/h1_nav2_ros2_ws
UNITREE_ROS_SETUP=/home/unitree/unitree_ros2/install/setup.bash
UNITREE_SDK2_ROOT=/home/unitree/unitree_sdk2
H1_2_NETWORK_INTERFACE=eth0
H1_2_DDS_CONFIG=/home/unitree/h1_nav2_ros2_ws/config/cyclonedds_pc4.xml
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
H1_2_WEB_HEARTBEAT_TIMEOUT_SEC=2
